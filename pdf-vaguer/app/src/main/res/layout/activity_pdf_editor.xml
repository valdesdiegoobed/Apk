<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">
        <Button
            android:id="@+id/btnPrev"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="‹" />
        <TextView
            android:id="@+id/txtPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Página 1/1"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnUndo"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="↶" />
        <Button
            android:id="@+id/btnRedo"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="↷" />
        <Button
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="›" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">
            <Button android:id="@+id/btnSelect" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Seleccionar" />
            <Button android:id="@+id/btnEdit" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Editar" />
            <Button android:id="@+id/btnText" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Texto" />
            <Button android:id="@+id/btnPaste" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Pegar" />
            <Button android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Buscar" />
            <Button android:id="@+id/btnAlignLeft" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Izq." />
            <Button android:id="@+id/btnAlignCenter" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Centro" />
            <Button android:id="@+id/btnAlignRight" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Der." />
            <Button android:id="@+id/btnNudgeLeft" android:layout_width="52dp" android:layout_height="44dp" android:text="←" />
            <Button android:id="@+id/btnNudgeRight" android:layout_width="52dp" android:layout_height="44dp" android:text="→" />
            <Button android:id="@+id/btnImage" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Imagen/Firma" />
            <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Guardar" />
            <Button android:id="@+id/btnShare" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Compartir" />
            <Button android:id="@+id/btnWhatsApp" android:layout_width="wrap_content" android:layout_height="44dp" android:text="WhatsApp" />
            <Button android:id="@+id/btnRotate" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Rotar" />
            <Button android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Eliminar pág." />
            <Button android:id="@+id/btnReorder" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Reordenar" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.vaguer.pdfeditor.PdfPageView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#DADADA"
        android:scaleType="fitCenter" />

</LinearLayout>
